# Copia este archivo como .env.e2e (no se versiona) y completa las credenciales
# de los usuarios de prueba del backend local.
E2E_BASE_URL=http://localhost:5173

E2E_MANAGER_USER=
E2E_MANAGER_PASS=

# El administrador ingresa con nombre de usuario (no correo).
E2E_ADMIN_USER=
E2E_ADMIN_PASS=
E2E_ADMIN_LOCATION=Casa Matriz

E2E_CASHIER_USER=
E2E_CASHIER_PASS=
# Sucursal donde el usuario tiene rol de cajero y un turno abierto.
E2E_CASHIER_LOCATION=Casa Matriz

# Producto con stock para las ventas (nombre exacto y precio)
E2E_PRODUCT=Para Tres
E2E_PRODUCT_PRICE=275
# Producto SIN stock para el caso negativo (vacío = se omite la prueba)
E2E_PRODUCT_NO_STOCK=
